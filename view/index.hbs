<h1>{{title}}</h1>

<div class="timer-container">
    <p>Введите количество секунд для таймера:</p>
    
    <div class="input-group">
        <input type="number" id="secondsInput" value="60" min="1" placeholder="60">
        <button id="fetchTimer">Получить время с сервера</button>
    </div>

    <div id="result" class="result"></div>
</div>